{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nemo.local/game-site-pipeline/analytics-snapshot.schema.json",
  "title": "Game Site Analytics Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_key",
    "snapshot_at",
    "site_url",
    "gsc",
    "ga",
    "indexing",
    "observation",
    "decision",
    "template_readiness"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_key": {"type": "string", "minLength": 1},
    "snapshot_at": {"type": "string", "format": "date-time"},
    "site_url": {"type": "string", "minLength": 1},
    "gsc": {"$ref": "#/$defs/provider"},
    "ga": {"$ref": "#/$defs/provider"},
    "indexing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at", "sitemap_url", "indexed_pages", "evidence"],
      "properties": {
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "sitemap_url": {"type": ["string", "null"]},
        "indexed_pages": {"type": ["integer", "null"], "minimum": 0},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "next_review_dates", "technical_checks"],
      "properties": {
        "day": {"type": "integer", "minimum": 0},
        "next_review_dates": {"type": "array", "items": {"type": "string", "format": "date-time"}},
        "technical_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "evidence"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "status": {"enum": ["passed", "failed", "unknown"]},
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "rationale", "approved_by", "approved_at"],
      "properties": {
        "recommendation": {"enum": ["none", "grow", "hold", "retire"]},
        "rationale": {"type": ["string", "null"]},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "template_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "reusable_scope", "product_specific_exclusions", "approved_by", "approved_at"],
      "properties": {
        "approved": {"type": "boolean"},
        "reusable_scope": {"type": ["string", "null"]},
        "product_specific_exclusions": {"type": ["string", "null"]},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup_status",
        "setup_mode",
        "property",
        "authorization_id",
        "readback_at",
        "data_status",
        "period",
        "metrics"
      ],
      "properties": {
        "setup_status": {"enum": ["not_started", "verified", "failed"]},
        "setup_mode": {"enum": ["existing", "created"]},
        "property": {"type": ["string", "null"]},
        "authorization_id": {"type": ["string", "null"]},
        "readback_at": {"type": ["string", "null"], "format": "date-time"},
        "data_status": {"enum": ["valid", "no_valid_data", "error"]},
        "period": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": {"type": ["string", "null"], "format": "date"},
            "end": {"type": ["string", "null"], "format": "date"}
          }
        },
        "metrics": {"type": "object"}
      }
    }
  }
}
