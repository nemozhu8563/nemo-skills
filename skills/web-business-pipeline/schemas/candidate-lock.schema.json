{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nemo.local/web-business-pipeline/candidate-lock.schema.json",
  "title": "Web Business Candidate Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key",
    "name",
    "source_report",
    "source_report_sha256",
    "locked_at",
    "qualification",
    "identities",
    "business_hypothesis",
    "decision"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "source_report": {"type": "string", "minLength": 1},
    "source_report_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "locked_at": {"type": "string", "format": "date-time"},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "checked_at", "checks"],
      "properties": {
        "status": {"const": "qualified"},
        "method": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "format": "date-time"},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "criterion", "status", "evidence_refs", "observations"],
            "properties": {
              "check_id": {"type": "string", "minLength": 1},
              "criterion": {"type": "string", "minLength": 1},
              "status": {"const": "passed"},
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "observations": {"type": "object"}
            }
          }
        }
      }
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "id"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "id": {"type": "string", "minLength": 1}
        }
      }
    },
    "business_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_customer",
        "customer_problem",
        "value_proposition",
        "business_models",
        "primary_acquisition_channel",
        "primary_value_event",
        "riskiest_assumption",
        "unknowns"
      ],
      "properties": {
        "target_customer": {"type": "string", "minLength": 1},
        "customer_problem": {"type": "string", "minLength": 1},
        "value_proposition": {"type": "string", "minLength": 1},
        "business_models": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "primary_acquisition_channel": {"type": "string", "minLength": 1},
        "primary_value_event": {"type": "string", "minLength": 1},
        "riskiest_assumption": {"type": "string", "minLength": 1},
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "confirmed_key", "rationale"],
      "properties": {
        "status": {"const": "approved"},
        "approved_by": {"type": "string", "minLength": 1},
        "confirmed_key": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
