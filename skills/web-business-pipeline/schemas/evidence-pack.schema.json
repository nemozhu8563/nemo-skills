{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nemo.local/web-business-pipeline/evidence-pack.schema.json",
  "title": "Web Business Evidence Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_key", "sources", "page_evidence", "claims"],
  "properties": {
    "schema_version": {"const": 2},
    "candidate_key": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "url",
          "title",
          "source_type",
          "reliability",
          "retrieved_at",
          "current_as_of"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "reliability": {"enum": ["official", "trusted", "community", "unverified"]},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "current_as_of": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "page_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_id", "source_ids"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "source_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "page_id",
          "text",
          "claim_type",
          "evidence_requirement",
          "source_ids",
          "status",
          "verified_at"
        ],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "page_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "claim_type": {"type": "string", "minLength": 1},
          "evidence_requirement": {"enum": ["standard", "current_trusted"]},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["verified", "provisional", "rejected"]},
          "verified_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
