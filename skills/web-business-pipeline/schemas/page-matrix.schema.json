{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nemo.local/web-business-pipeline/page-matrix.schema.json",
  "title": "Web Business Page Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_key", "base_locale", "locales", "pages"],
  "properties": {
    "schema_version": {"const": 2},
    "candidate_key": {"type": "string", "minLength": 1},
    "base_locale": {"type": "string", "minLength": 2},
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "demand_validated", "demand_evidence", "content_complete"],
        "properties": {
          "locale": {"type": "string", "minLength": 2},
          "demand_validated": {"type": "boolean"},
          "demand_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "content_complete": {"type": "boolean"}
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_id",
          "slug",
          "page_type",
          "locale",
          "primary_keyword",
          "keyword_aliases",
          "intent_key",
          "search_intent",
          "user_goal",
          "allowed_fields",
          "allowed_actions",
          "allowed_states",
          "non_goals"
        ],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "slug": {"type": "string", "minLength": 1},
          "page_type": {"type": "string", "minLength": 1},
          "locale": {"type": "string", "minLength": 2},
          "primary_keyword": {"type": "string", "minLength": 1},
          "keyword_aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "intent_key": {"type": "string", "minLength": 1},
          "search_intent": {"type": "string", "minLength": 1},
          "user_goal": {"type": "string", "minLength": 1},
          "allowed_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "allowed_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "allowed_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
