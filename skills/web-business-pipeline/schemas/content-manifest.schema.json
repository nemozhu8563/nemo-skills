{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nemo.local/web-business-pipeline/content-manifest.schema.json",
  "title": "Web Business Content Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_key", "pages"],
  "properties": {
    "schema_version": {"const": 2},
    "candidate_key": {"type": "string", "minLength": 1},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_id",
          "path",
          "title",
          "locale",
          "primary_keyword",
          "status",
          "source_ids",
          "claim_ids",
          "content_sha256",
          "human_reviewed",
          "reviewed_by",
          "reviewed_at"
        ],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "locale": {"type": "string", "minLength": 2},
          "primary_keyword": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "draft", "reviewed", "published"]},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "human_reviewed": {"type": "boolean"},
          "reviewed_by": {"type": ["string", "null"]},
          "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
