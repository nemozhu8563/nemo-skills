  "target_platforms": [
    "openai",
    "claude",
    "generic",
    "agent-skills-compatible"
  ],
  "dependencies": [
    {
      "skill": "game-site-pipeline",
      "version": ">=0.2.0",
      "required": true
    }
  ],
  "intent": {
    "job_to_be_done": "把已经能做好单篇内容的能力放大成有限批次：先规划至少十个真实搜索意图，再按同类几个一批生成、核验、人工审核并重走上线观察链。",
    "target_users": [
      "Nemo",
      "game-site operator"
    ],
    "inputs": [
      "`grow`，且增长决定包含有效 GSC/关键词机会；单篇手动流程已被证明"
    ],
    "outputs": [
      "至少十个内页的意图清单和有限批次计划",
      "可复用但证据受限的页面生产契约",
      "更新后的矩阵、证据、内容、QA 和人审结果",
      "重发/telemetry handoff，或最终 observing gate"
    ],
    "exclusions": [
      "关键词一换就复制同一篇内容",
      "没有真实来源也批量填充数值、技能或打法",
      "一开始就写自动抓取/生成脚本替代尚未跑通的手工流程"
    ]
  },
  "release_gates": [
    "central_pipeline_dependency",
    "root_entrypoint_isolation",
    "validate_skill",
    "trigger_eval",
    "export_skill_ir",
    "suite_contract_tests",
    "action_boundary",
    "missing_evidence_guard"
  ]
