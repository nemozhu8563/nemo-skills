      "最小实现检查结果",
      "build_ready gate 或 expansion validation 结果"
    ],
    "exclusions": [
      "为了未来复用重构整个站点",
      "生成矩阵之外的薄页或语言版本",
      "把模型自检称为人工内容审核或发布验收"
    ]
  },
  "release_gates": [
    "central_pipeline_dependency",
    "root_entrypoint_isolation",
    "validate_skill",
    "trigger_eval",
